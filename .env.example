# Copy to .env and edit. All settings are optional; defaults shown.

# --- Model ---
CANARY_MODEL_NAME=nvidia/canary-1b-flash
CANARY_SERVED_MODEL_NAME=canary-1b-flash
CANARY_DEVICE=auto              # auto | cuda | cpu
CANARY_COMPUTE_DTYPE=float32    # float32 | float16 | bfloat16 (GPU only)

# --- Inference ---
CANARY_BEAM_SIZE=1
CANARY_BATCH_SIZE=1
CANARY_TARGET_SAMPLE_RATE=16000
CANARY_MAX_UPLOAD_BYTES=104857600

# --- Server ---
CANARY_HOST=0.0.0.0
CANARY_PORT=8777
# Leave empty to disable auth; otherwise clients send "Authorization: Bearer <key>".
CANARY_API_KEY=
